{
  "id": null,
  "uid": "media-applications",
  "title": "Media Applications",
  "description": "Jellyfin and media automation metrics from native Jellyfin scraping and Exportarr.",
  "tags": [
    "homelab",
    "media",
    "jellyfin",
    "exportarr"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Exportarr app",
        "type": "custom",
        "query": "Sonarr,Radarr,Lidarr,Prowlarr,Bazarr",
        "refresh": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 10,
      "type": "row",
      "title": "Service health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Jellyfin scrape",
      "description": "Whether Prometheus can scrape Jellyfin's native metrics endpoint.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"jellyfin\"}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Exportarr targets",
      "description": "Number of Exportarr instances currently being scraped successfully.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(up{job=~\"exportarr.*\",app=~\"$app\"})", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 5 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Exportarr collector errors",
      "description": "A collector error can leave the exporter target up while a metric group is incomplete.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum({job=~\"exportarr.*\",app=~\"$app\",__name__=~\".*_collector_error\"})", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Jellyfin",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Jellyfin process resources",
      "description": "Jellyfin process CPU and resident memory, when exposed by the native metrics endpoint.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(process_cpu_seconds_total{job=\"jellyfin\"}[5m])", "legendFormat": "CPU cores" },
        { "refId": "B", "expr": "process_resident_memory_bytes{job=\"jellyfin\"}", "legendFormat": "Resident memory" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "decbytes", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "stacking": { "mode": "none", "group": "A" } } },
        "overrides": [ { "matcher": { "id": "byName", "options": "CPU cores" }, "properties": [ { "id": "unit", "value": "cores" } ] } ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 12,
      "type": "row",
      "title": "Exportarr operations",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exportarr queue totals",
      "description": "Queue items reported by Sonarr, Radarr, Lidarr, Prowlarr and Bazarr.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (app) ({job=\"exportarr\",app=~\"$app\",__name__=~\".*_queue_total\"})", "legendFormat": "{{app}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 1, "fillOpacity": 15, "showPoints": "auto", "stacking": { "mode": "none", "group": "A" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Media wanted and missing",
      "description": "Metrics whose names include wanted or missing, where supported by the exporter version and application.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=\"exportarr\",app=~\"$app\",__name__=~\".*(wanted|missing).*\"})", "legendFormat": "{{app}} {{__name__}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10, "showPoints": "auto", "stacking": { "mode": "none", "group": "A" } } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Jellyfin metric inventory",
      "description": "A quick inventory of metrics currently returned by Jellyfin. This is intentionally dynamic as the native endpoint varies by version and enabled features.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "count by (__name__) ({job=\"jellyfin\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Storage",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 14,
      "type": "row",
      "title": "Exportarr value groups",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "type": "table",
      "title": "Counts",
      "description": "Count and total metrics across the selected Exportarr applications.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=~\"exportarr.*\",app=~\"$app\",__name__=~\".*(_total|_count|_number|_items).*\",__name__!~\".*(queue|wanted|missing|cutoff|filesize|size_bytes|freespace|free_space).*\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 16,
      "type": "table",
      "title": "File sizes",
      "description": "Library and media file size metrics across the selected Exportarr applications.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=~\"exportarr.*\",app=~\"$app\",__name__=~\".*(filesize|size_bytes).*\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Free space",
      "description": "Free-space metrics across the selected Exportarr applications.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=~\"exportarr.*\",app=~\"$app\",__name__=~\".*(freespace|free_space).*\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 19,
      "type": "table",
      "title": "Rates and activity",
      "description": "Download, upload, speed, bandwidth and activity metrics across the selected Exportarr applications.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=~\"exportarr.*\",app=~\"$app\",__name__=~\".*(rate|speed|bandwidth|download|upload|activity).*\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Durations",
      "description": "Scrape, query and collector duration metrics across the selected Exportarr applications.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=~\"exportarr.*\",app=~\"$app\",__name__=~\".*(duration|latency).*\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 22,
      "type": "table",
      "title": "Errors and health",
      "description": "Collector errors, failures, health and status metrics across the selected Exportarr applications.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 73 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=~\"exportarr.*\",app=~\"$app\",__name__=~\".*(error|failed|health|status).*\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    },
    {
      "id": 23,
      "type": "table",
      "title": "Other Exportarr metrics",
      "description": "Metrics not matched by the primary value groups above, retained for discovery without mixing them into operational panels.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 73 },
      "datasource": { "type": "prometheus", "uid": "stacks-prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (__name__, app) ({job=~\"exportarr.*\",app=~\"$app\",__name__!~\".*(filesize|size_bytes|freespace|free_space|_total|_count|_number|_items|queue|wanted|missing|cutoff|rate|speed|bandwidth|download|upload|activity|duration|latency|error|failed|health|status).*\"})", "instant": true, "format": "table" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "showHeader": true, "footer": { "show": false }, "sortBy": [ { "displayName": "Value", "desc": true } ] }
    }
  ]
}
