{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/London",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major"],
      "groupName": "{{packageFileDir}} major",
      "dependencyDashboardApproval": true
    },
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "{{packageFileDir}} non-major",
      "automerge": true,
      "automergeSchedule": ["at any time"],
      "platformAutomerge": false
    },
    {
      "description": "Limit Nextcloud updates to 1 major version.",
      "matchPackageNames": ["nextcloud"],
      "maxMajorIncrement": 1
    },
    {
      "description": "Auto-update wiksite on push.",
      "matchFileNames": ["wiksite/**"],
      "automergeSchedule": ["at any time"],
      "automerge": true
    }
  ]
}