{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "ignorePaths": ["archive/**"],
  "timezone": "Europe/London",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["major"],
      "groupName": "{{packageFileDir}} major"
    },
    {
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "{{packageFileDir}} non-major"
    },
    {
      "description": "Limit Nextcloud updates to 1 major version.",
      "matchPackageNames": ["nextcloud"],
      "maxMajorIncrement": 1
    },
    {
      "description": "Keep Nextcloud MariaDB within its supported version ranges.",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["nextcloud/compose.yaml"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": ">=11.8 <11.9"
    },
    {
      "description": "Ignore the unpinned Wiksite image.",
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["wiksite/compose.yaml"],
      "matchPackageNames": ["ghcr.io/insignificant74/wik_74site"],
      "matchUpdateTypes": ["pinDigest"],
      "enabled": false
    }
  ]
}
