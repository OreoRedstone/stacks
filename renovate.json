{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "ignorePaths": [
    "immich/**"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "description": "Limit Nextcloud updates to 1 major version.",
      "matchPackageNames": ["nextcloud"],
      "maxMajorIncrement": 1
    },
    {
      "description": "Auto-update wiksite on push.",
      "matchFileNames": ["wiksite/**"],
      "automerge": true
    }
  ]
}
