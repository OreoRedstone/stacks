{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["docker-compose"],
      "matchFileNames": ["**/compose.yaml"],
      "groupName": "{{packageFileDir}}"
    },
    {
      "description": "Limit Nextcloud updates to 1 major version.",
      "matchPackageNames": ["nextcloud"],
      "maxMajorIncrement": 1
    },
    {
      "description": "Auto-update wiksite on push.",
      "matchFileNames": ["wiksite/**"],
      "automergeSchedule": ["at any time"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automergeSchedule": ["* 0-4 * * *"],
      "automerge": true
    }
  ]
}
